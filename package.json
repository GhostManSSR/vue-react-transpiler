{
  "name": "vue-to-react-ast",
  "version": "0.1.0",
  "description": "Small AST-based Vue SFC to React TSX converter",
  "keywords": [
    "vue",
    "react",
    "ast",
    "converter",
    "codemod",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "vue-to-react-ast": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.28.5",
    "@vue/compiler-dom": "3.5.24",
    "@vue/compiler-sfc": "3.5.24"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.4",
    "rollup": "^4.64.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
